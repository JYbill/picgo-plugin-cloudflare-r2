{
  "name": "picgo-plugin-cloudflare-r2-xqv",
  "version": "1.0.6",
  "description": "picgo for cloudflare-r2 storage by xiaoqinvar",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/JYbill/picgo-plugin-cloudflare-r2",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/JYbill/picgo-plugin-cloudflare-r2.git"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "build": "tsc -p .",
    "build:watch": "tsc -w -p .",
    "dev": "node --watch test/index.js",
    "lint": "eslint src --fix",
    "skills:update": "skills add JYbill/xqv-skills --copy -a universal -y -s ddt -s notes -s test-optimize",
    "patch": "npm version patch && git push origin master && git push origin --tags",
    "minor": "npm version minor && git push origin master && git push origin --tags",
    "major": "npm version major && git push origin master && git push origin --tags"
  },
  "keywords": [
    "picgo",
    "picgo-plugin",
    "picgo-gui-plugin"
  ],
  "author": "xiaoqinvar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.19.3",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.0",
    "eslint-plugin-standard": "^3.1.0",
    "picgo": "^1.6.6",
    "skills": "^1.7.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.669.0",
    "mime": "^4.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ejs"
    ]
  }
}
